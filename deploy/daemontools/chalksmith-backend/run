#!/bin/sh
set -eu

APP_DIR=${APP_DIR:-/home/avazhou/apps/Chalksmith-ai}
HOST=${HOST:-0.0.0.0}
PORT=${PORT:-8010}
VENV=${VENV:-$APP_DIR/.venv}
ENV_FILE=${ENV_FILE:-$APP_DIR/backend/.env.local}
RUN_AS_USER=${RUN_AS_USER:-avazhou}

if [ "$(id -u)" = "0" ] && [ -n "$RUN_AS_USER" ] && [ "${CHALKSMITH_DAEMONTOOLS_DROPPED:-}" != "1" ]; then
  export APP_DIR HOST PORT VENV ENV_FILE RUN_AS_USER
  export CHALKSMITH_DAEMONTOOLS_DROPPED=1
  exec setuidgid "$RUN_AS_USER" "$0"
fi

cd "$APP_DIR"
mkdir -p "$APP_DIR/backend/static"

if [ ! -x "$VENV/bin/uvicorn" ]; then
  echo "Missing uvicorn at $VENV/bin/uvicorn. Run scripts/server/chalksmith-backend install first." >&2
  exit 111
fi

if [ ! -f "$ENV_FILE" ]; then
  echo "Missing environment file: $ENV_FILE" >&2
  exit 111
fi

set -a
. "$ENV_FILE"
set +a

export PYTHONUNBUFFERED=1

exec "$VENV/bin/uvicorn" backend.main:app \
  --host "$HOST" \
  --port "$PORT" \
  --proxy-headers \
  --forwarded-allow-ips="${FORWARDED_ALLOW_IPS:-127.0.0.1}"
