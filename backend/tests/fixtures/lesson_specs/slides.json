{
  "schema_version": "chalksmith.slides.v2",
  "format": "slides",
  "summary": "A structured lesson about equivalent fractions.",
  "title": "Equivalent Fractions",
  "learning_goal": "Explain why two fractions can name the same quantity.",
  "grade_band": "elementary",
  "language": "en",
  "payload": {
    "slides": [
      {
        "title": "Our goal",
        "label": "Learning goal",
        "background": "default",
        "layout": "single",
        "blocks": [
          {
            "type": "prose",
            "paragraphs": ["We will recognize fractions that name the same amount."],
            "presentation": "lead",
            "appearance": "plain"
          }
        ]
      },
      {
        "title": "Equal parts",
        "label": "Visual explanation",
        "background": "soft",
        "layout": "right-wide",
        "blocks": [
          {
            "type": "key-point",
            "summary": "Same amount",
            "explanation": "One half and two fourths cover equal portions of a whole.",
            "presentation": "accent-bar",
            "appearance": "soft"
          },
          {
            "type": "custom-html",
            "description": "One half and two fourths shown as equal bars",
            "html": "<style>.bars{display:grid;gap:1rem}.bar{display:grid;grid-template-columns:repeat(4,1fr);gap:.2rem}.part{height:4rem;border:.08rem solid var(--cs-border);background:var(--cs-surface-raised)}.fill{background:var(--cs-accent)}</style><figure class=\"bars\"><div class=\"bar\"><span class=\"part fill\"></span><span class=\"part fill\"></span><span class=\"part\"></span><span class=\"part\"></span></div><div class=\"bar\"><span class=\"part fill\"></span><span class=\"part fill\"></span><span class=\"part\"></span><span class=\"part\"></span></div><figcaption>One half equals two fourths.</figcaption></figure>"
          }
        ]
      },
      {
        "title": "Build an equivalent fraction",
        "label": "Worked example",
        "background": "default",
        "layout": "right-wide",
        "blocks": [
          {
            "type": "list",
            "items": [
              {"summary": "Start with one half."},
              {"summary": "Multiply both numbers by two."},
              {"summary": "Read the equivalent fraction."}
            ],
            "presentation": "numbered",
            "appearance": "card"
          },
          {
            "type": "equation",
            "items": [
              {
                "latex": "\\frac{1}{2} \\times \\frac{2}{2} = \\frac{2}{4}",
                "explanation": "Multiply the numerator and denominator by the same number."
              }
            ],
            "appearance": "card"
          }
        ]
      },
      {
        "title": "Equivalent fraction pairs",
        "label": "Check understanding",
        "background": "contrast",
        "layout": "single",
        "blocks": [
          {
            "type": "table",
            "columns": ["Starting fraction", "Equivalent fraction", "Multiplier"],
            "rows": [
              ["1/2", "2/4", "×2"],
              ["2/3", "4/6", "×2"],
              ["3/4", "6/8", "×2"]
            ],
            "appearance": "card"
          }
        ]
      },
      {
        "title": "Remember",
        "label": "Recap",
        "background": "accent",
        "layout": "top-1-bottom-2",
        "blocks": [
          {
            "type": "key-point",
            "summary": "The key rule",
            "explanation": "Multiply or divide the numerator and denominator by the same nonzero number.",
            "presentation": "callout",
            "appearance": "accent"
          },
          {
            "type": "key-point",
            "summary": "Numerator",
            "explanation": "Apply the operation to the top number.",
            "presentation": "tagged",
            "badge": "Top",
            "appearance": "card"
          },
          {
            "type": "key-point",
            "summary": "Denominator",
            "explanation": "Apply the same operation to the bottom number.",
            "presentation": "tagged",
            "badge": "Bottom",
            "appearance": "card"
          }
        ]
      }
    ]
  }
}
