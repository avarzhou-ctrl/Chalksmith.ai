# v2 application
APP_ENV=local
APP_ROLE=api
FRONTEND_ORIGINS=http://localhost:3000
GCP_PROJECT_ID=gemini-code-shark
GOOGLE_APPLICATION_CREDENTIALS=.env/your-service-account.json

# Clerk session-token verification
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# v2 LLM Provider
LLM_PROVIDER=vertex
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=16384
VERTEX_AI_LOCATION=global
OPENAI_API_KEY=

# v2 data and storage
CLOUD_SQL_INSTANCE=
DATABASE_URL=sqlite:///./.env/chalksmith.local.db
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
GCS_BUCKET=
GCS_SIGNER_SERVICE_ACCOUNT=
SIGNED_URL_TTL_SECONDS=900
AUTO_CREATE_TABLES=true
GENERATION_TIMEOUT_SECONDS=900
MANIM_TIMEOUT_SECONDS=600
MAX_RENDER_BYTES=100000000
MANIM_RENDERER_URL=http://localhost:8081
MAX_SOURCE_FILES=5
MAX_SOURCE_BYTES=10000000
MAX_TOTAL_SOURCE_BYTES=25000000
MAX_SOURCE_CHARACTERS=120000
