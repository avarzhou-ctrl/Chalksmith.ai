{
  "title": "Mathematical Foundations: Area",
  "scenes": [
    {
      "id": "intro-01",
      "type": "title",
      "content": "Understanding Area",
      "physics": "smooth",
      "durationInSeconds": 3
    },
    {
      "id": "def-02",
      "type": "text",
      "content": "Area is the measure of the total space occupied by a two-dimensional surface or shape.",
      "physics": "bouncy",
      "durationInSeconds": 5
    },
    {
      "id": "units-03",
      "type": "math",
      "content": "\\text{Area is expressed in square units: } u^2",
      "physics": "snappy",
      "durationInSeconds": 4
    },
    {
      "id": "rect-04",
      "type": "point_list",
      "content": "[\"Rectangle Area Formula\", \"A = l \\\\times w\", \"l = \\\\text{length}\", \"w = \\\\text{width}\"]",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "ex-rect-05",
      "type": "math",
      "content": "\\text{Example: } l=8m, w=4m \\\\implies A = 8m \\\\times 4m = 32m^2",
      "physics": "bouncy",
      "durationInSeconds": 6
    },
    {
      "id": "tri-06",
      "type": "math",
      "content": "A_{\\\\text{triangle}} = \\\\frac{1}{2} \\\\times b \\\\times h",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "circ-07",
      "type": "point_list",
      "content": "[\"Circle Area Formula\", \"A = \\\\pi r^2\", \"r = \\\\text{radius}\", \"\\\\pi \\\\approx 3.14159\"]",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "ex-circ-08",
      "type": "math",
      "content": "\\text{If } r = 3, A = \\\\pi(3)^2 = 9\\\\pi \\\\approx 28.27",
      "physics": "bouncy",
      "durationInSeconds": 6
    },
    {
      "id": "summary-09",
      "type": "title",
      "content": "Area = 2D Coverage",
      "physics": "smooth",
      "durationInSeconds": 4
    }
  ]
}