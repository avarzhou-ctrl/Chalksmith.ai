{
  "title": "Mathematics: The Concept of Area",
  "scenes": [
    {
      "id": "intro-title",
      "type": "title",
      "content": "Understanding Area",
      "physics": "bouncy",
      "durationInSeconds": 4
    },
    {
      "id": "definition-text",
      "type": "text",
      "content": "Area is the measure of the size of a surface or a two-dimensional shape within a set boundary.",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "square-units",
      "type": "math",
      "content": "\\text{Area is measured in square units: } u^{2}",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "rect-formula",
      "type": "math",
      "content": "\\text{Rectangle: } A = l \\times w",
      "physics": "smooth",
      "durationInSeconds": 5
    },
    {
      "id": "rect-example",
      "type": "math",
      "content": "l = 8m, w = 4m \\implies A = 8 \\times 4 = 32m^{2}",
      "physics": "bouncy",
      "durationInSeconds": 6
    },
    {
      "id": "triangle-formula",
      "type": "math",
      "content": "\\text{Triangle: } A = \\frac{1}{2} b h",
      "physics": "smooth",
      "durationInSeconds": 5
    },
    {
      "id": "circle-formula",
      "type": "math",
      "content": "\\text{Circle: } A = \\pi r^{2}",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "summary-list",
      "type": "point_list",
      "content": "Key Takeaways: Area represents 2D space; Formulas vary by geometry; Units are always squared.",
      "physics": "smooth",
      "durationInSeconds": 8
    }
  ]
}