    },
    {
      "id": "units-math",
      "type": "math",
      "content": "\\text{Area is expressed in square units, such as } m^2 \\text{ or } cm^2",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "rectangle-concept",
      "type": "math",
      "content": "A_{\\text{rectangle}} = l \\times w",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "rectangle-example",
      "type": "point_list",
      "content": "For a rectangle with length 8m and width 5m: 8 \\times 5 = 40m^2",
      "physics": "snappy",
      "durationInSeconds": 7
    },
    {
      "id": "triangle-concept",
      "type": "math",
      "content": "A_{\\text{triangle}} = \\frac{1}{2} (b \\times h)",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "circle-concept",
      "type": "math",
      "content": "A_{\\text{circle}} = \\pi r^2",
      "physics": "bouncy",
      "durationInSeconds": 6
    },
    {
      "id": "summary-points",
      "type": "point_list",
      "content": "Rectangle: l * w | Triangle: 1/2 * b * h | Circle: π * r²",
      "physics": "smooth",
      "durationInSeconds": 8
    }
  ]
