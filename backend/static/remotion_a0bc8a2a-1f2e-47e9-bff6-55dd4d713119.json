{
  "title": "Area of Parallelograms and Triangles",
  "scenes": [
    {
      "id": "intro",
      "type": "title",
      "content": "Area of Parallelograms and Triangles",
      "physics": "bouncy",
      "durationInSeconds": 4
    },
    {
      "id": "para-def",
      "type": "text",
      "content": "A parallelogram's area is determined by its base ($b$) and its perpendicular height ($h$).",
      "physics": "smooth",
      "durationInSeconds": 5
    },
    {
      "id": "para-formula",
      "type": "math",
      "content": "A = b \\times h",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "tri-derivation",
      "type": "text",
      "content": "Any triangle can be seen as exactly one-half of a parallelogram with the same base and height.",
      "physics": "smooth",
      "durationInSeconds": 6
    },
    {
      "id": "tri-formula",
      "type": "math",
      "content": "A = \\frac{1}{2} (b \\times h)",
      "physics": "bouncy",
      "durationInSeconds": 5
    },
    {
      "id": "example-problem",
      "type": "point_list",
      "content": "• Base ($b$) = 10cm\n• Height ($h$) = 6cm\n• Parallelogram Area = 60cm²\n• Triangle Area = 30cm²",
      "physics": "smooth",
      "durationInSeconds": 7
    },
    {
      "id": "critical-reminder",
      "type": "text",
      "content": "Important: The height must always be perpendicular (at a 90° angle) to the base.",
      "physics": "snappy",
      "durationInSeconds": 5
    },
    {
      "id": "summary-math",
      "type": "math",
      "content": "A_{triangle} = \\frac{b \\cdot h}{2}",
      "physics": "smooth",
      "durationInSeconds": 4
    }
  ]
}