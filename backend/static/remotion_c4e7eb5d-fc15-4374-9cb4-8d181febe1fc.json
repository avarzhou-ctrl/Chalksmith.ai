{
  "title": "Introduction to the Binary System",
  "scenes": [
    {
      "id": "intro-scene",
      "type": "title",
      "heading": "The Binary System",
      "content": "The Language of Computers",
      "durationInSeconds": 4,
      "layout": "centered"
    },
    {
      "id": "definition-scene",
      "type": "text",
      "heading": "What is Binary?",
      "content": "Binary is a Base-2 positional numeral system. Unlike the decimal system (Base-10) which uses digits 0-9, binary uses only two symbols: 0 and 1. These individual digits are known as bits, short for binary digits.",
      "durationInSeconds": 7,
      "layout": "split"
    },
    {
      "id": "place-values-math",
      "type": "math",
      "heading": "Positional Notation",
      "content": "V = d_{n}2^{n} + \\dots + d_{1}2^{1} + d_{0}2^{0}",
      "durationInSeconds": 6,
      "layout": "centered"
    },
    {
      "id": "place-values-list",
      "type": "point_list",
      "heading": "Powers of Two",
      "items": [
        "2^0 = 1 (Units)",
        "2^1 = 2 (Twos)",
        "2^2 = 4 (Fours)",
        "2^3 = 8 (Eights)",
        "2^4 = 16 (Sixteens)"
      ],
      "durationInSeconds": 8,
      "layout": "split"
    },
    {
      "id": "conversion-example",
      "type": "math",
      "heading": "Conversion: 10110 in Binary",
      "content": "(1 \\times 2^4) + (0 \\times 2^3) + (1 \\times 2^2) + (1 \\times 2^1) + (0 \\times 2^0)",
      "durationInSeconds": 8,
      "layout": "centered"
    },
    {
      "id": "conversion-result",
      "type": "math",
      "heading": "The Result",
      "content": "16 + 0 + 4 + 2 + 0 = 22_{10}",
      "durationInSeconds": 5,
      "layout": "centered"
    },
    {
      "id": "summary-scene",
      "type": "point_list",
      "heading": "Summary",
      "items": [
        "Base-2 system using only 0 and 1",
        "Fundamental unit is the bit",
        "Values are calculated using powers of 2",
        "Essential for digital logic and circuits"
      ],
      "durationInSeconds": 7,
      "layout": "bottom"
    }
  ],
  "audioConfig": {
    "generateVoiceover": true,
    "voice": "alloy"
  }
}