      "durationInSeconds": 4
    },
    {
      "id": "rectangle-example-text",
      "type": "text",
      "content": "Calculate the area of a rectangle with a length of 8m and a width of 4m.",
      "physics": "smooth",
      "durationInSeconds": 5
    },
