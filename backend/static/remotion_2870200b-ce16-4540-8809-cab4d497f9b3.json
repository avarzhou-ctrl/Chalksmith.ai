{
  "title": "Understanding Area",
  "scenes": [
    {
      "id": "intro-scene",
      "type": "title",
      "heading": "Introduction to Area",
      "content": "Measuring Two-Dimensional Space",
      "durationInSeconds": 4,
      "layout": "centered"
    },
    {
      "id": "definition-scene",
      "type": "text",
      "heading": "What is Area?",
      "content": "Area is the measure of the size of a surface. It represents the amount of space inside the boundary of a flat (2-dimensional) object.",
      "durationInSeconds": 6,
      "layout": "centered"
    },
    {
      "id": "units-scene",
      "type": "math",
      "heading": "Units of Measurement",
      "content": "\\text{Area is measured in square units, such as } m^2, \\text{ } cm^2, \\text{ or } in^2.",
      "durationInSeconds": 5,
      "layout": "centered"
    },
    {
      "id": "rectangle-formula",
      "type": "math",
      "heading": "Area of a Rectangle",
      "content": "A = l \\times w",
      "durationInSeconds": 5,
      "layout": "split"
    },
    {
      "id": "rectangle-example",
      "type": "math",
      "heading": "Example Calculation",
      "content": "\\text{If } l = 5m \\text{ and } w = 3m, \\text{ then: } A = 5 \\times 3 = 15m^2",
      "durationInSeconds": 7,
      "layout": "centered"
    },
    {
      "id": "triangle-formula",
      "type": "math",
      "heading": "Area of a Triangle",
      "content": "A = \\frac{1}{2} \\times b \\times h",
      "durationInSeconds": 5,
      "layout": "split"
    },
    {
      "id": "circle-formula",
      "type": "math",
      "heading": "Area of a Circle",
      "content": "A = \\pi r^2",
      "durationInSeconds": 5,
      "layout": "centered"
    },
    {
      "id": "real-world-list",
      "type": "point_list",
      "heading": "Real-World Applications",
      "items": [
        "Calculating floor space for tiling",
        "Determining the amount of paint for a wall",
        "Measuring land size for construction",
        "Fabric cutting for clothing design"
      ],
      "durationInSeconds": 8,
      "layout": "bottom"
    },
    {
      "id": "summary-scene",
      "type": "text",
      "heading": "Summary",
      "content": "Area measures the surface within a 2D boundary using square units. Different shapes require specific formulas based on their dimensions.",
      "durationInSeconds": 6,
      "layout": "centered"
    }
  ],
  "audioConfig": {
    "generateVoiceover": true,
