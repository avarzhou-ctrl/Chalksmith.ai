# Copy this template to exactly one environment file, then replace every
# placeholder with values from the matching Clerk instance:
#
#   STAGING AND LOCAL DEVELOPMENT
#   cp bin/clerk.key.template .env/clerk.key.stg
#   chmod 600 .env/clerk.key.stg
#
#   PRODUCTION
#   cp bin/clerk.key.template .env/clerk.key.prod
#   chmod 600 .env/clerk.key.prod
#
# Required for both environments, but the values must come from different Clerk
# instances:
#
#   .env/clerk.key.stg
#     - Select the Clerk Development instance.
#     - CLERK_ISSUER normally ends in .clerk.accounts.dev.
#     - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY starts with pk_test_.
#     - CLERK_SECRET_KEY starts with sk_test_.
#
#   .env/clerk.key.prod
#     - Select the Clerk Production instance after configuring its root domain
#       and DNS records.
#     - CLERK_ISSUER is the exact production Frontend API URL, normally
#       https://clerk.<DOMAIN>.
#     - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY starts with pk_live_.
#     - CLERK_SECRET_KEY starts with sk_live_.
#
# Do not add CLERK_AUTHORIZED_PARTIES here. Locally it inherits
# FRONTEND_ORIGINS from .env/env.local. Production deploy.sh derives both values
# from DOMAIN and injects them directly into chalksmith-api-prod.

# Required: exact Frontend API URL without a trailing slash.
CLERK_ISSUER=https://replace-with-clerk-frontend-api

# Required: matching values from Clerk Dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-publishable-key
CLERK_SECRET_KEY=replace-with-secret-key

# Optional: leave blank unless Clerk is configured with an explicit override.
# An empty JWKS URL makes the backend use CLERK_ISSUER/.well-known/jwks.json.
CLERK_JWKS_URL=
CLERK_AUDIENCE=
