# Local runtime configuration shared by the Next.js web process and FastAPI.
# Copy this file once, restrict its permissions, and replace every placeholder:
#
#   cp bin/env.local.template .env/env.local
#   chmod 600 .env/env.local
#
# Clerk values do not belong here. Create .env/clerk.key.stg separately from
# bin/clerk.key.template. Values are literal; ${...} references are not expanded.

# Local runtime roles. bin/debug.sh overrides APP_ROLE=renderer only for the
# isolated renderer process.
APP_ENV=local
APP_ROLE=api

# Browser origins allowed by FastAPI CORS. When CLERK_AUTHORIZED_PARTIES is not
# explicitly set, the backend uses this same list to validate Clerk JWT `azp`.
FRONTEND_ORIGINS=http://localhost:3000

# Local service targets. These are singular base URLs; application code appends
# the API and renderer route paths.
NEXT_PUBLIC_API_URL=http://localhost:8000
MANIM_RENDERER_URL=http://localhost:8081

# Google Cloud project used for Vertex AI, the staging bucket, and Cloud SQL.
# Local authentication comes from `gcloud auth application-default login`; do
# not add a service-account JSON key unless the documented ADC flow is replaced.
GCP_PROJECT_ID=replace-with-project-id

# Default local provider: Vertex AI Gemini.
LLM_PROVIDER=vertex
LLM_MODEL=gemini-3.6-flash
VERTEX_AI_LOCATION=global

# OpenAI alternative: replace the three active Vertex lines above with this
# block. Do not leave two provider configurations active at the same time.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=replace-with-openai-api-key

# DeepSeek alternative: same rule, replace the active Vertex lines above. Models
# are deepseek-v4-flash (cheaper) and deepseek-v4-pro. The key comes from
# https://platform.deepseek.com/api_keys and belongs in .env/env.local only,
# which git ignores; never commit it to this template.
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Staging PostgreSQL reached through cloud-sql-proxy on 127.0.0.1:5432.
# Fetch chalksmith-db-password-stg from Secret Manager and percent-encode URL
# reserved characters before inserting it. Do not leave angle brackets here.
DATABASE_URL=postgresql://chalksmith:replace-with-url-encoded-password@127.0.0.1:5432/chalksmith

# Local debugging shares the staging bucket. Bucket naming and IAM are created
# by bin/setup.sh stg; replace the project id in the signer account.
GCS_BUCKET=chalksmith-gcs-stg
GCS_SIGNER_SERVICE_ACCOUNT=chalksmith-api@replace-with-project-id.iam.gserviceaccount.com

# Optional overrides. Uncomment only when changing the validated defaults in
# backend/app/core/config.py.
# SIGNED_URL_TTL_SECONDS=900
# GENERATION_TIMEOUT_SECONDS=900
# MANIM_TIMEOUT_SECONDS=600
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_OUTPUT_TOKENS=16384
# MAX_RENDER_BYTES=100000000
# MAX_SOURCE_FILES=5
# MAX_SOURCE_BYTES=10000000
# MAX_TOTAL_SOURCE_BYTES=25000000
# MAX_SOURCE_CHARACTERS=200000
# AUTO_CREATE_TABLES=true
