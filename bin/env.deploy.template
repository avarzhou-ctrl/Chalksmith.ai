# Deployment configuration read automatically by bin/deploy.sh.
# Copy this file once, restrict its permissions, and replace every placeholder:
#
#   cp bin/env.deploy.template .env/env.deploy
#   chmod 600 .env/env.deploy
#   ./bin/deploy.sh prod start
#
# Values are literal: quotes, shell commands, and ${...} references are not
# evaluated. Already-exported shell variables take precedence for one-off
# overrides. Clerk values remain in .env/clerk.key.stg and clerk.key.prod.

# Required for staging and production.
PROJECT_ID=replace-with-project-id
REGION=us-central1
LLM_PROVIDER=vertex
LLM_MODEL=gemini-3.6-flash
VERTEX_AI_LOCATION=global

# Optional LLM cost and latency guardrails. Lower values reduce worst-case token
# spend but may truncate complex lessons or large source-backed requests.
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_OUTPUT_TOKENS=16384
# MAX_SOURCE_CHARACTERS=200000

# Required only for production. Use a bare root domain without a scheme, path,
# port, spaces, or commas.
DOMAIN=example.com

# OpenAI alternative: replace the active LLM_PROVIDER/LLM_MODEL values above and
# name the Secret Manager secret holding the API key. Store the key itself in
# Secret Manager, never in this file.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_SECRET_NAME=chalksmith-openai-key-prod

# DeepSeek alternative: same rule. deploy.sh mounts LLM_SECRET_NAME as
# DEEPSEEK_API_KEY on the API service and grants the API service account
# secretAccessor on it. Create the secret first:
#
#   printf %s "<deepseek-api-key>" | \
#     gcloud secrets create chalksmith-deepseek-key-prod --data-file=-
#
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# LLM_SECRET_NAME=chalksmith-deepseek-key-prod

# Optional staging browser origins, comma-separated. The generated staging
# run.app web URL is always added after deployment.
# STAGING_ORIGINS=https://staging.example.com

# Optional resource-name overrides. Leave commented to use Chalksmith's
# environment-suffixed defaults.
# BUILD_SERVICE_ACCOUNT=chalksmith-deployer@replace-with-project-id.iam.gserviceaccount.com
# CLOUD_SQL_INSTANCE_NAME=chalksmith-postgres-prod
# API_SERVICE=chalksmith-api-prod
# RENDERER_SERVICE=chalksmith-renderer-prod
# WEB_SERVICE=chalksmith-web-prod
# ARTIFACT_REPOSITORY=chalksmith-prod
# GCS_BUCKET=chalksmith-gcs-prod
# DATABASE_NAME=chalksmith
# DATABASE_USER=chalksmith
# DB_PASSWORD_SECRET_NAME=chalksmith-db-password-prod
# CLERK_KEY_SECRET_NAME=chalksmith-clerk-key-prod
# CLERK_KEY_FILE=.env/clerk.key.prod
# REVISION_TAG=replace-with-image-tag
